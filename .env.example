# Database (local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_calorie_tracker"

# Auth.js / NextAuth
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# AI providers (multimodal / vision) — used with fallback in this order:
# 1. Gemini -> 2. OpenRouter -> 3. Groq
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# IP local de tu PC en la red Wi-Fi, para probar la app desde el celular en desarrollo
# (ver "ipconfig" -> IPv4 Address del adaptador Wi-Fi). No es necesaria en producción.
DEV_LAN_IP=""
