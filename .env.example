# Database (local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/nutrisnap"

# Auth.js / NextAuth
# Generar con: npx auth secret   (o cualquier string random largo)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# AI providers (multimodal / vision) — used with fallback in this order:
# 1. Gemini -> 2. OpenRouter -> 3. Groq
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# Opcional: override del modelo de cada proveedor (los free tiers cambian seguido).
# Defaults actuales: gemini-3.8-flash / google/gemma-4-31b-it:free / qwen/qwen3.8-27b
GEMINI_MODEL=""
OPENROUTER_MODEL=""
GROQ_MODEL=""

# IP local de tu PC en la red Wi-Fi, para probar la app desde el celular en desarrollo
# (ver "ipconfig" -> IPv4 Address del adaptador Wi-Fi). No es necesaria en producción.
DEV_LAN_IP=""
